{
  "name": "covault-v3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "lint": "eslint . --max-warnings=0",
    "verify": "npm run typecheck && npm run typecheck:unused && npm run lint && npm test && npm run build",
    "cap:sync": "cap sync android && bash scripts/sync-android.sh",
    "cap:build": "npm run build && cap sync android && bash scripts/sync-android.sh"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@huggingface/transformers": "^4.3.0",
    "@sentry/react": "^10.73.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.103.2",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.103.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
