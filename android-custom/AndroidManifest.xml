<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Notification permissions:
        - POST_NOTIFICATIONS is required for sending notifications (Android 13+)
        - BIND_NOTIFICATION_LISTENER_SERVICE is NOT declared here as a uses-permission;
          it is only used as the service-level android:permission on the
          NotificationListenerService below. Declaring it at the manifest level
          can interfere with the Android system App Info three-dot menu that
          exposes "Advanced / Special app access" (including notification access).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Seeing which apps are installed, so the user can pick which of them
        Covault listens to.

        From Android 11 onwards getInstalledApplications returns only apps that
        are "visible" to the caller, and an app with no <queries> and no
        QUERY_ALL_PACKAGES sees almost nothing. A picker that cannot see the
        user's banking and mail apps has nothing to offer and reads as broken —
        and the "we don't recognise this app, do you want it?" suggestion, which
        is the only route for a bank Covault has never heard of, stops working
        entirely.

        The blunt permission rather than a <queries> list because the list would
        have to name all ~350 known banks AND could still not surface an
        unrecognised one, which is the case it exists for. Google restricts this
        permission for Play Store distribution; Covault is installed from its own
        GitHub releases and is never submitted to the Play Store, so that
        restriction does not apply. If it is ever published there, this has to
        become an explicit <queries> list and the unknown-app suggestions have to
        go with it.

        Nothing about an app is read here beyond its package name and its own
        label. No notification from an unapproved app is ever examined.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Storage permissions for CSV file downloads (only needed for Android 9 and below) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!--
        Self-update: Covault installs its own new versions rather than the user
        downloading an APK by hand. This permission only lets the app *ask* —
        Android still shows its own install confirmation every time, and on
        Android 8+ the user has to allow Covault as an install source once in
        Settings before even the ask is honoured (CovaultUpdaterPlugin sends
        them there).
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        The other half of an APK update that arrives by itself, and useless
        without it: since Android 12 an app may replace ITSELF without the
        install confirmation, but only if it declares this alongside
        REQUEST_INSTALL_PACKAGES. Without this line
        setRequireUserAction(USER_ACTION_NOT_REQUIRED) is ignored in silence and
        every update falls back to the confirmation screen — which still works,
        which is exactly why the omission would be so easy to miss.

        It grants nothing on its own: it is a normal permission with no prompt,
        it applies only to updates of packages this app installed or is itself,
        and the user's one-time "allow Covault to install apps" is still what
        gates the whole thing.
    -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!--
        Background web updates fetch a small bundle with no one watching, so
        they must not put a progress bar in the notification shade. The APK
        download is now equally quiet — nobody asked for it either.
    -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <!-- For keeping the app running in background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link support for OAuth callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.covault.app" />
            </intent-filter>

        </activity>

        <!--
            Notification Listener Service for banking apps.
            The android:permission here restricts who can bind to the service
            (only the system, which holds BIND_NOTIFICATION_LISTENER_SERVICE).
            The intent-filter action registers this service as a notification listener,
            which makes it appear under Settings > Apps > Special app access >
            Notification access (or via the three-dot overflow menu on App Info).
        -->
        <service
            android:name=".NotificationListener"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Boot receiver to restart notification listener after reboot -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
            Home-screen widget: this month's spending as a donut.
            exported="true" is required — the launcher hosts the widget in its
            own process and has to be able to deliver APPWIDGET_UPDATE to it.
            The provider reads only Covault's own SharedPreferences.
        -->
        <receiver
            android:name=".CovaultWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.covault.app.WIDGET_MIDNIGHT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/covault_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
