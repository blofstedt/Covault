<?xml version="1.0" encoding="utf-8"?>
<!--
  Everything visual is the bitmap WidgetRenderer produces, including the card
  surface and its rounded corners. RemoteViews supports only a small set of
  views and no custom drawing, so a single ImageView is the whole widget.

  fitCenter (not fitXY) because the bitmap is deliberately clamped below the
  widget's true pixel size to stay under the RemoteViews transaction limit —
  it is scaled back up here, and the aspect ratio has to be preserved or the
  donut turns into an ellipse.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      android:src is the widget PICKER's preview. previewLayout renders this
      layout, and with no src that was an empty transparent rectangle — you
      chose Covault from the widget list by picking a blank tile. At runtime
      setImageViewBitmap replaces it, so the same drawable serves both.
    -->
    <ImageView
        android:id="@+id/widget_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_preview"
        android:contentDescription="@string/widget_description" />

    <!--
      The tap target for the "N to review" pill, which is painted into the
      bitmap and so cannot be clicked on its own. Sized and placed to cover
      where the pill is drawn: top-right, inset by the renderer's padding.
      GONE unless something is actually waiting, so the rest of the time the
      whole widget keeps its ordinary "open Covault" tap.

      An empty FrameLayout rather than the obvious `<View>`. RemoteViews are
      inflated by the launcher, in its process, and it will only inflate the
      handful of classes the framework marks as remotable — `View` itself is
      not one of them. A layout containing one fails to inflate at all, and
      what the user sees is "Can't load widget" with no clue why.
      widgetLayoutViews.test.ts fails the build on any element outside that
      set.
    -->
    <FrameLayout
        android:id="@+id/widget_review_hit"
        android:layout_width="112dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:visibility="gone" />

</FrameLayout>
